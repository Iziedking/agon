# Copy this file to .env and fill in real values. .env is gitignored.
# Foundry auto-loads .env from this folder (the project root) when you run forge.

# Required: deployer key. Needs testnet USDC for gas (USDC is gas on Arc).
PRIVATE_KEY=0xyour_deployer_private_key

# Optional: all default to the deployer address if left unset.
# ADMIN_ADDRESS=0x...
# TREASURY_ADDRESS=0x...
# COORDINATOR_ADDRESS=0x...

# Optional: default to verified Arc testnet values if left unset.
# USDC_ADDRESS=0x3600000000000000000000000000000000000000
# IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e

# Optional: economics. Defaults are LISTING_FEE=0 and PLATFORM_FEE_BPS=500 (5%).
# LISTING_FEE=0
# PLATFORM_FEE_BPS=500
