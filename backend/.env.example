# Copy to .env and adjust. .env is gitignored.

# --- Database and cache (match docker-compose.yml) ---
# Host ports are 5434/6380 to avoid clashing with a local Postgres/Redis on the defaults.
DATABASE_URL=postgres://arcrun:arcrun@localhost:5434/arcrun
REDIS_URL=redis://localhost:6380

# --- Arc testnet (verified via arc-docs) ---
ARC_RPC_HTTP=https://rpc.testnet.arc.network
ARC_RPC_WS=wss://rpc.testnet.arc.network
CHAIN_ID=5042002

# Block to start indexing from. Use the contracts' deploy block to avoid a long
# backfill. 0 means from genesis (slow). The deploy was around block 43667548.
START_BLOCK=43667548

# Path to the committed deployments file (relative to where you run the service).
DEPLOYMENTS_FILE=../contracts/deployments/arc-testnet.json

# --- Coordinator ---
# Wallet that opens, scores, and settles contests. Keep this secret, and fund it
# with testnet USDC (faucet.circle.com). With this set, the coordinator autopilot
# runs the whole platform from one `docker compose up`: no per-contest commands.
# COORDINATOR_PRIVATE_KEY=0x...

# --- Autopilot (self-driving contests; needs COORDINATOR_PRIVATE_KEY) ---
# AUTOPILOT=0                    # turn the loop off even with a key set
# AUTOPILOT_TYPE=solver          # solver | analyst | scout | rotate
# AUTOPILOT_POOL_USDC=2          # prize pool per contest
# AUTOPILOT_DURATION_SECONDS=180 # how long entries stay open
# AUTOPILOT_GAP_SECONDS=30       # pause between one contest settling and the next opening
# AUTOPILOT_SWEEP_SECONDS=60     # how often to settle any due contest, including ones hosted by other operators

# --- Scout runner ---
# Master mnemonic for deriving per-agent hot wallets. Use a private one in
# production; the agent hot wallets are sandboxed and hold only small balances.
# The autopilot tops these up automatically before each Scout contest settles.
# SCOUT_MASTER_MNEMONIC=...
# SCOUT_FUND_USDC=1              # USDC each Scout hot wallet is topped up to

# --- Reputation and points (step 7) ---
# The coordinator applies in-game reputation and credits Cycles on settle. Those
# need COORDINATOR_PRIVATE_KEY to hold COORDINATOR_ROLE on ContestEngine and
# PointsLedger (granted at deploy to the coordinator address).
# QUALIFY_MIN_POINTS=0          # min Cycles to enter; 0 leaves entry open
# ERC-8004 feedback is posted from a SEPARATE validator wallet (must differ from
# the agent NFT owner). Fund it with USDC. Unset = feedback step skipped.
# VALIDATOR_PRIVATE_KEY=0x...

# --- Auth ---
AUTH_PORT=8082
# JWT_SECRET=change-me
# Admin token for the activity log read endpoint (GET /admin/events). Keep it
# secret; without it the read endpoint is disabled. Send it as the x-admin-token header.
# ADMIN_TOKEN=change-me-to-a-long-random-string
# X is optional (social linking only); the wallet is the identity.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_CALLBACK_URL=http://localhost:8082/auth/x/callback
