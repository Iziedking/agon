# Copy to .env and adjust. .env is gitignored.

# --- Database and cache ---
# Docker path: ports 5434 / 6380 (match docker-compose.yml) to avoid clashing
# with a local Postgres/Redis on the defaults.
# npm path: ports 5432 / 6379 if you installed Postgres and Redis locally.
DATABASE_URL=postgres://arcrun:arcrun@localhost:5434/arcrun
REDIS_URL=redis://localhost:6380

# --- Arc testnet (verified via arc-docs) ---
ARC_RPC_HTTP=https://rpc.testnet.arc.network
ARC_RPC_WS=wss://rpc.testnet.arc.network
CHAIN_ID=5042002

# Block to start indexing from. Use the contracts' deploy block to avoid a long
# backfill. 0 means from genesis (slow). The deploy was around block 43667548.
START_BLOCK=43667548

# Path to the committed deployments file (relative to where you run the service).
DEPLOYMENTS_FILE=../contracts/deployments/arc-testnet.json

# --- Arcana Markets (external prediction-market integration) ---
# Verified live contract at this address on Arc Testnet (chain 5042002).
# The indexer subscribes to SharesBought, MarketResolved, WinningsClaimed and
# the Analyst runner reads open markets here to seed agent predictions.
# Owner: 0x3b4a7deb1274a6f802f45455c6a3998a1d8384d9 (single EOA).
# Set ARCANA_INDEXING=0 to disable the Arcana indexer subscription without
# tearing down the rest of the stack.
ARCANA_MARKETS_ADDRESS=0x443a47eF1025e047879b1BA08c94e6dedB354D54
# ARCANA_START_BLOCK is where the indexer begins backfilling Arcana events.
# Match the rest of the indexer by default; raise if the Arcana contract was
# deployed later than START_BLOCK to skip empty ranges.
ARCANA_START_BLOCK=43667548
# ARCANA_INDEXING=1

# --- Analyst contest / Prediction challenge gating ---
# When false (default), PREDICTION events hold for Arcana markets. If no
# open markets exist at settlement time, the contest/challenge cancels and
# refunds stakes. Set to 1 to allow the legacy synthetic Brier fallback
# (dev environments without Arcana coverage).
# ANALYST_ALLOW_SYNTHETIC=0

# --- Analyst autofund ---
# When an agent enters an Analyst contest with an empty (or under-funded) hot
# wallet, the coordinator drips USDC from COORDINATOR_PRIVATE_KEY so the agent
# can actually trade on Arcana. Per-agent cap: one drip per UTC day. Global
# cap: ANALYST_AUTOFUND_DAILY_USD across all agents. Set
# ANALYST_AUTOFUND=0 to disable.
#
# The Circle Arc Testnet faucet refreshes ~$20 USDC per 2 hours
# (~$240/day capacity), so the $50/day default cap leaves plenty of headroom.
# ANALYST_AUTOFUND=1
# Per-tier drip amounts in whole USDC, four comma-separated values for
# tiers 1..4 (tier 0 is ineligible for Analyst Arcana contests).
# ANALYST_AUTOFUND_USDC_BY_TIER=5,10,15,25
# Legacy single value (applied to every tier). If set and the per-tier var
# is at its default, this wins. Kept for back-compat.
# ANALYST_AUTOFUND_USDC=5
# ANALYST_AUTOFUND_DAILY_USD=50      # default $50/day global ceiling
# ANALYST_AUTOFUND_MIN_BALANCE=1     # only drip if agent balance < this (USDC)

# --- Coordinator ---
# Wallet that opens, scores, and settles contests. Keep this secret, and fund it
# with testnet USDC (faucet.circle.com). With this set, the coordinator autopilot
# runs the whole platform from one `docker compose up`: no per-contest commands.
# COORDINATOR_PRIVATE_KEY=0x...

# --- Autopilot (self-driving contests; needs COORDINATOR_PRIVATE_KEY) ---
# AUTOPILOT=0                        # turn the loop off even with a key set
# AUTOPILOT_TYPE=rotate              # solver | analyst | scout | rotate (cycles across all three)
# AUTOPILOT_POOL_USDC_MIN=1          # lower bound of the randomized pool, USDC
# AUTOPILOT_POOL_USDC_MAX=10         # upper bound of the randomized pool, USDC
# AUTOPILOT_POOL_USDC=...            # legacy single value; if set, overrides min and max
# AUTOPILOT_DURATION_SECONDS_MIN=180 # lower bound of the join window in seconds (3 min default)
# AUTOPILOT_DURATION_SECONDS_MAX=1500 # upper bound of the join window in seconds (25 min default)
# AUTOPILOT_DURATION_SECONDS=...     # legacy fixed value; if set, used as both min and max
# AUTOPILOT_GAP_SECONDS=360          # pause between one contest settling and the next opening (6 min default for demo)
# AUTOPILOT_SWEEP_SECONDS=60         # how often to settle any due contest, including ones hosted by other operators
# AUTOPILOT_FILL_CHALLENGES=1        # auto-join solo challenges as bot agent so they don't cancel

# Random peer challenges (separate loop). Same min/max pattern as contests above.
# AUTOPILOT_RANDOM_CHALLENGES=1
# AUTOPILOT_CHALLENGE_STAKE_MIN=0.5
# AUTOPILOT_CHALLENGE_STAKE_MAX=2
# AUTOPILOT_CHALLENGE_JOIN_SECONDS_MIN=180   # 3 min lower bound
# AUTOPILOT_CHALLENGE_JOIN_SECONDS_MAX=1500  # 25 min upper bound
# AUTOPILOT_CHALLENGE_JOIN_SECONDS=...       # legacy fixed value; if set, used as both bounds
# AUTOPILOT_CHALLENGE_RESOLVE_SECONDS=1800   # window after join close for the challenge to resolve
# AUTOPILOT_CHALLENGE_CYCLE_SECONDS=600      # gap between successive challenge creations
# AUTOPILOT_CHALLENGE_KINDS=0,1,2,3          # comma-separated kind set to draw from
# AUTOPILOT_RANDOM_CHALLENGES=1      # also create random peer challenges every cycle so the lobby is never empty

# --- Scout runner ---
# Master mnemonic for deriving per-agent hot wallets. Use a private one in
# production; the agent hot wallets are sandboxed and hold only small balances.
# The autopilot tops these up automatically before each Scout contest settles.
# SCOUT_MASTER_MNEMONIC=...
# SCOUT_FUND_USDC=1                  # USDC each Scout hot wallet is topped up to

# --- Reputation and points ---
# The coordinator applies in-game reputation and credits Cycles on settle. Those
# need COORDINATOR_PRIVATE_KEY to hold COORDINATOR_ROLE on ContestEngine and
# PointsLedger (granted at deploy to the coordinator address).
# QUALIFY_MIN_POINTS=0               # min Cycles to enter; 0 leaves entry open
# ERC-8004 feedback is posted from a SEPARATE validator wallet (must differ from
# the agent NFT owner). Fund it with USDC. Unset = feedback step skipped.
# VALIDATOR_PRIVATE_KEY=0x...

# --- Agent training ---
# Base seconds per level: level N → N+1 takes (N+1) × this. Default 3600
# (60 min) for a real wait the speedup ladder is worth paying for. Set
# small (e.g. 30) in demo for fast judge walkthroughs.
# TRAINING_BASE_SECONDS_PER_LEVEL=3600
# Speedup ladder: pay extra cycles at start to shave wall-clock. Default
# is +50 cycles per step, each step shaves 15 min (900s). Hard floor on
# total wait is TRAINING_MIN_SECONDS so a fully sped-up training still has
# a visible duration in the queue.
# TRAINING_SPEEDUP_CYCLES_PER_STEP=50
# TRAINING_SPEEDUP_SECONDS_PER_STEP=900
# TRAINING_MIN_SECONDS=60

# --- Auth ---
AUTH_PORT=8082
# Sets the cookie domain check. Use localhost:3000 for dev, your real domain for prod.
# AUTH_DOMAIN=localhost:3000
# APP_URL=http://localhost:3000
# JWT_SECRET=change-me-to-a-long-random-string
# Admin token for the activity log read endpoint (GET /admin/events). Keep it
# secret; without it the read endpoint is disabled. Send it as the x-admin-token header.
# ADMIN_TOKEN=change-me-to-a-long-random-string

# --- Social link OAuth (all optional; wallet is the identity) ---
# X (Twitter)
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_CALLBACK_URL=http://localhost:8082/auth/x/callback
# Telegram (login widget)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# Discord (oauth2 identify)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_CALLBACK_URL=http://localhost:8082/auth/discord/callback

# --- Email OTP (production blocker for email signup) ---
# Required before mainnet. When EMAIL_OTP_ENABLED=true, a never-seen
# email must verify a 6-digit code before /auth/email/begin will hand
# out a passkey-registration challenge. Returning passkey users skip
# this entirely. Off by default so the testnet demo doesn't need an
# email-send service. Set OTP_PEPPER to a long random string so the
# at-rest code hash stays opaque if the DB leaks.
# EMAIL_OTP_ENABLED=false
# EMAIL_PROVIDER=console
# EMAIL_FROM=noreply@arcrun.app
# RESEND_API_KEY=
# OTP_PEPPER=change-me-to-a-long-random-string

# --- Circle Developer-Controlled Wallets (email login) ---
# Backs the email path. Backend signs every contract call for email users via
# POST /wallet/execute. Run scripts/circle-bootstrap.ts once to generate the
# entity secret and create the wallet set, then paste the printed values here.
# Without these, the email login flow returns 503.
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_SET_ID=
# CIRCLE_BLOCKCHAIN=ARC-TESTNET
# CIRCLE_AUTO_SEED_USDC=true         # seed new wallets with testnet USDC from Circle's faucet

# --- WebAuthn passkey ---
# RP_ID is the registrable domain the passkey is bound to (no port, no protocol).
# ORIGIN must include the protocol and port.
# Local dev: RP_ID=localhost, ORIGIN=http://localhost:3000
# Prod:      RP_ID=arcrun.app, ORIGIN=https://arcrun.app
# WEBAUTHN_RP_NAME=ArcRun
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3000

# --- Anthropic (real LLM runners) ---
# Empty key falls back to the synthetic tier-curve simulation so dev environments
# don't require a paid API key. With a key set, every LLM-enabled tier calls
# Claude per puzzle / per prediction / per scout strategy.
# ANTHROPIC_API_KEY=
# Hard daily ceiling on LLM spend in USD. Runners stop calling Anthropic mid-round
# when exceeded.
# LLM_DAILY_KILL_USD=5
# Default LLM model for every tier that calls the LLM. Tiers 2 and 3 always
# use this. Default Haiku 4.5 keeps testnet cost flat. Override per the
# steeper marketing tier curve (1 / 2 / 4 / 8 / 16) by setting
# LLM_MODEL_TIER4 below for mainnet, where tier 4 is the absolute best agent.
# LLM_MODEL=claude-haiku-4-5-20251001
# Optional. When set, tier 4 calls use this smarter brain while tiers 0 to 3
# stay on LLM_MODEL. Typical mainnet values: claude-sonnet-4-6 or claude-opus-4-7.
# Leave unset on testnet so the demo cost stays predictable.
# LLM_MODEL_TIER4=
# Testing safety belt: strip web_search (the only paid server-tool), clamp
# max_tokens to 200, disable retries. Use during smoke runs.
# LLM_TESTING=false
