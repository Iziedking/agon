# arcrun backend
# copy this whole file to .env, then fill in the values marked <fill in>.
# defaults work for local docker dev. .env is gitignored.

# === required: db + cache ===
DATABASE_URL=postgres://arcrun:arcrun@localhost:5434/arcrun
REDIS_URL=redis://localhost:6380

# === required: arc testnet ===
ARC_RPC_HTTP=https://rpc.testnet.arc.network
ARC_RPC_WS=wss://rpc.testnet.arc.network
CHAIN_ID=5042002
START_BLOCK=43667548
DEPLOYMENTS_FILE=../contracts/deployments/arc-testnet.json

# === required: keys you fill in ===
# fund all wallets from faucet.circle.com. coordinator and validator must be
# distinct addresses. validator must NOT own any agent NFTs (ERC-8004 rule).
COORDINATOR_PRIVATE_KEY=<fill in 0x...>
VALIDATOR_PRIVATE_KEY=<fill in 0x...>
SCOUT_MASTER_MNEMONIC=<fill in 12-word mnemonic>
ANTHROPIC_API_KEY=<fill in or leave empty for synthetic mode>
# Conduit is a drop-in for the Anthropic Messages API (keys are sk-cdt-...).
# When both are set, Conduit is the PRIMARY for every claude-* call and
# ANTHROPIC_API_KEY above is the fallback. Set the BASE only (no /v1/messages).
# CONDUIT_API_KEY=<fill in sk-cdt-...>
# CONDUIT_BASE_URL=<fill in, e.g. https://api.conduit.example>

# === required: circle dev-controlled wallets (email login + nanopayments) ===
# run `npm run circle:bootstrap` once to mint the entity secret + wallet set;
# paste the printed values back here.
CIRCLE_API_KEY=<fill in>
CIRCLE_ENTITY_SECRET=<fill in>
CIRCLE_WALLET_SET_ID=<fill in>
CIRCLE_BLOCKCHAIN=ARC-TESTNET

# === required: arcana markets (external prediction-market integration) ===
ARCANA_MARKETS_ADDRESS=0x443a47eF1025e047879b1BA08c94e6dedB354D54
ARCANA_START_BLOCK=43667548

# === auth ===
AUTH_PORT=8082
AUTH_DOMAIN=localhost:3000
APP_URL=http://localhost:3000
JWT_SECRET=<fill in long random string>
WEBAUTHN_RP_NAME=ArcRun
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# === nanopayments (x402 research spend for all three agent kinds) ===
# setup once: `npm install -g @circle-fin/cli`, then
#   circle wallet create --type agent --chain BASE
#   circle gateway deposit --amount 5 --address <that wallet> --chain BASE --method eco
# paste the wallet address into NANOPAY_WALLET_ADDRESS below, then set NANOPAY_ENABLED=1.
NANOPAY_ENABLED=0
NANOPAY_WALLET_ADDRESS=<fill in 0x... circle agent wallet>
# NANOPAY_PREDICTION_ENDPOINT=https://nano.blockrun.ai/api/v1/pm/polymarket/markets
# NANOPAY_PREDICTION_LABEL=Predexon prediction markets
# tier budgets default to 0.01 / 0.05 / 0.25 / 1.0 / 5.0 USDC per puzzle.
# NANOPAY_TIER_0_BUDGET_USDC=0.01
# NANOPAY_TIER_4_BUDGET_USDC=5.0
# NANOPAY_SETTLEMENT_CHAIN=MATIC
# NANOPAY_MAX_PER_CALL_USDC=2.0
# research is a tier 3+ ability; lower tiers reason without paid data.
# NANOPAY_MIN_RESEARCH_TIER=3
# NANOPAY_SESSION_BUDGET_USDC=2.0
# analyst buys sentiment-tagged crypto news before trading ($0.05/call).
# Gloria settles as plain on-chain USDC on Base — paid from the agent
# wallet's Base USDC balance, not the Gateway pool. keep it topped up.
# NANOPAY_ANALYST_NEWS_ENDPOINT=https://api.itsgloria.ai/news-by-keyword
# NANOPAY_ANALYST_NEWS_LABEL=Gloria AI news
# NANOPAY_ANALYST_NEWS_CHAIN=BASE
# scout buys spot prices before sizing ($0.008/call). AIsa settles on
# Polygon via Gateway — same domain the eco deposit funds. smoke-tested.
# NANOPAY_SCOUT_PRICE_ENDPOINT=https://api.aisa.one/apis/v2/coingecko/simple/price?ids=ethereum,usd-coin&vs_currencies=usd
# NANOPAY_SCOUT_PRICE_LABEL=AIsa market prices
# NANOPAY_SCOUT_PRICE_CHAIN=MATIC
# optional: solver web search for quiz/classify kinds. Exa ($0.007/call)
# needs Gateway balance on the Base domain (direct deposit, not eco).
# AIsa's tavily proxy 502'd after taking payment on 2026-06-10 — avoid.
# NANOPAY_QUIZ_ENDPOINT=https://api.exa.ai/search
# NANOPAY_QUIZ_LABEL=Exa web search
# NANOPAY_CLASSIFY_ENDPOINT=https://api.exa.ai/search
# NANOPAY_CLASSIFY_LABEL=Exa web search
# NANOPAY_RESEARCH_CHAIN=BASE

# === production blockers (off by default; flip on before mainnet) ===
# EMAIL_OTP_ENABLED=true
# EMAIL_PROVIDER=resend
# EMAIL_FROM=noreply@arcrun.xyz
# RESEND_API_KEY=
# OTP_PEPPER=<fill in long random string>
# STRICT_WALLET_SEPARATION=true

# === social login (all optional; wallet is the identity) ===
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_CALLBACK_URL=http://localhost:8082/auth/x/callback
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_CALLBACK_URL=http://localhost:8082/auth/discord/callback

# === admin ===
# secret token for the /admin/events read endpoint. unset disables that endpoint.
# ADMIN_TOKEN=<fill in long random string>

# === optional: autopilot tuning ===
# The arena runs on a daily SCHEDULE, not a tight loop. Contests open at fixed
# times of day (each category once per time), and missions open a couple of
# times a day at random. Both fire a Telegram alert when they open. The defaults
# below are what runs if you set nothing.
# AUTOPILOT=1
# AUTOPILOT_TYPE=rotate                  # or pin one: solver | analyst | scout
# SCHEDULE_TZ_OFFSET_HOURS=0             # shift all times off UTC (1 = WAT)
#
# --- contests: 3 fixed windows a day, every category at each ---
# AUTOPILOT_CONTEST_TIMES=08:00,13:00,19:00   # morning, noon, evening
# AUTOPILOT_CONTEST_CATEGORIES=solver,analyst,scout   # which open at each time
# AUTOPILOT_CONTEST_MIN_TIER=0           # tier gate floor
# AUTOPILOT_CONTEST_MAX_TIER=4           # ceiling (all-tier so anyone can join)
# AUTOPILOT_CONTEST_STAGGER_SECONDS=30   # gap between the per-category opens
# AUTOPILOT_OPEN_ON_BOOT=0               # 1 = also open one round on startup
# AUTOPILOT_POOL_USDC_MIN=1
# AUTOPILOT_POOL_USDC_MAX=10
# AUTOPILOT_DURATION_SECONDS_MIN=1200    # 20 min join window (min)
# AUTOPILOT_DURATION_SECONDS_MAX=2400    # 40 min join window (max)
# AUTOPILOT_HIGH_TIER_POOL_MULT=5        # used only if you set a tier 3+ floor
#
# --- missions: N a day at random inside the active window ---
# MISSION_ENABLED=true
# MISSION_PER_DAY=2                       # twice a day at random (0 = fixed interval)
# MISSION_ACTIVE_HOURS=08:00-22:00        # random mission times drawn from here
# MISSION_CADENCE_SECONDS=28800           # used ONLY when MISSION_PER_DAY=0
# MISSION_POOL_USDC_MIN=50
# MISSION_POOL_USDC_MAX=120
#
# --- sweepers + optional peer challenges (off by default) ---
# AUTOPILOT_SWEEP_SECONDS=30
# AUTOPILOT_RANDOM_CHALLENGES=1
# AUTOPILOT_CHALLENGE_STAKE_MIN=0.5
# AUTOPILOT_CHALLENGE_STAKE_MAX=2
# AUTOPILOT_CHALLENGE_CYCLE_SECONDS=3600       # one challenge per hour when on
# AUTOPILOT_CHALLENGE_JOIN_SECONDS_MIN=900     # 15 min join window (min)
# AUTOPILOT_CHALLENGE_JOIN_SECONDS_MAX=2700    # 45 min join window (max)

# === optional: scheduler mode ===
# SCHEDULER_MODE=autopilot     # autopilot | cadence | manual

# === optional: analyst autofund (drips usdc into agents for arcana trades) ===
# ANALYST_AUTOFUND=1
# ANALYST_AUTOFUND_USDC_BY_TIER=5,10,15,25
# ANALYST_AUTOFUND_DAILY_USD=50
# ANALYST_AUTOFUND_MIN_BALANCE=1
# ANALYST_ALLOW_SYNTHETIC=0

# === optional: scout funding ===
# Hot wallets are funded to their tier amount (SCOUT_FUNDING_BY_TIER) bounded
# by this safety ceiling. The float is swept back after each round, so it
# recirculates and only gas/fees are spent.
# SCOUT_FUND_MAX_USDC=200
# legacy flat amount, used only by the fund-scouts helper script:
# SCOUT_FUND_USDC=1

# === optional: scout real DEX swaps (Circle App Kit Swap on Arc) ===
# Off by default; Scout self-transfers USDC. To turn on real swaps among
# USDC / EURC / cirBTC, install the adapter and set a kit key:
#   cd backend && npm i @circle-fin/adapter-viem-v2
#   get a free kit key from the Circle Console
# SCOUT_REAL_SWAPS=1
# CIRCLE_KIT_KEY=<fill in>
# SCOUT_SWAP_TOKEN_IN=USDC
# SCOUT_SWAP_TOKEN_OUT=EURC
# USDC is the gas token on Arc, so each swap leg keeps this much USDC back for
# gas; the runner swaps USDC -> EURC then EURC -> USDC to recirculate principal.
# SCOUT_GAS_RESERVE_USDC=0.10
# generic daily swap budget shared by every tier (smaller agents swap more
# to match a higher tier's volume):
# SCOUT_DAILY_SWAP_CAP=1024
# SCOUT_SWAPS_PER_RUN=24
# per-tier hot-wallet funding in whole USDC, index 0..4 (tier 0 -> 10,
# tier 4 -> 200). this is how much each agent's wallet holds per round, so
# it sets swap and transfer size. swept back after settlement.
# SCOUT_FUNDING_BY_TIER=10,25,50,100,200

# === optional: B5 cross-chain bridging (Scout op) ===
# A Scout op is occasionally a real one-way Arc -> Base CCTP bridge instead of a
# swap. The moved USDC counts toward the same volume score and shows as a BRIDGE
# row on the tape. OFF by default; set the fraction > 0 to turn it on. Each agent
# bridges at most SCOUT_BRIDGE_MAX_PER_LANE times per event, SCOUT_BRIDGE_USDC
# each (Arc CCTP outbound min is ~2 USDC). The Arc wallet is kept topped up by the
# autofunder so the outbound never stalls the race.
# SCOUT_BRIDGE_FRACTION=0.15
# SCOUT_BRIDGE_USDC=2
# SCOUT_BRIDGE_MAX_PER_LANE=2
# SCOUT_BRIDGE_SOURCE_CHAIN=Arc_Testnet
# SCOUT_BRIDGE_DEST_CHAIN=Base_Sepolia
# SCOUT_BRIDGE_DEST_LABEL=Base
# SCOUT_BRIDGE_TIMEOUT_MS=90000

# === optional: qualification gate ===
# QUALIFY_MIN_POINTS=0

# === optional: training timing (set small for demo walkthroughs) ===
# TRAINING_BASE_SECONDS_PER_LEVEL=3600
# TRAINING_SPEEDUP_CYCLES_PER_STEP=50
# TRAINING_SPEEDUP_SECONDS_PER_STEP=900
# TRAINING_MIN_SECONDS=60

# === optional: llm tuning ===
# LLM_DAILY_KILL_USD=5
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_MODEL_TIER4=                # only set on mainnet for a smarter tier 4
# LLM_TESTING=false

# === optional: circle wallet seeding ===
# CIRCLE_AUTO_SEED_USDC=true
