# Copy to .env and adjust. .env is gitignored.

# --- Database and cache ---
# Docker path: ports 5434 / 6380 (match docker-compose.yml) to avoid clashing
# with a local Postgres/Redis on the defaults.
# npm path: ports 5432 / 6379 if you installed Postgres and Redis locally.
DATABASE_URL=postgres://arcrun:arcrun@localhost:5434/arcrun
REDIS_URL=redis://localhost:6380

# --- Arc testnet (verified via arc-docs) ---
ARC_RPC_HTTP=https://rpc.testnet.arc.network
ARC_RPC_WS=wss://rpc.testnet.arc.network
CHAIN_ID=5042002

# Block to start indexing from. Use the contracts' deploy block to avoid a long
# backfill. 0 means from genesis (slow). The deploy was around block 43667548.
START_BLOCK=43667548

# Path to the committed deployments file (relative to where you run the service).
DEPLOYMENTS_FILE=../contracts/deployments/arc-testnet.json

# --- Coordinator ---
# Wallet that opens, scores, and settles contests. Keep this secret, and fund it
# with testnet USDC (faucet.circle.com). With this set, the coordinator autopilot
# runs the whole platform from one `docker compose up`: no per-contest commands.
# COORDINATOR_PRIVATE_KEY=0x...

# --- Autopilot (self-driving contests; needs COORDINATOR_PRIVATE_KEY) ---
# AUTOPILOT=0                        # turn the loop off even with a key set
# AUTOPILOT_TYPE=rotate              # solver | analyst | scout | rotate (cycles across all three)
# AUTOPILOT_POOL_USDC_MIN=1          # lower bound of the randomized pool, USDC
# AUTOPILOT_POOL_USDC_MAX=10         # upper bound of the randomized pool, USDC
# AUTOPILOT_POOL_USDC=...            # legacy single value; if set, overrides min and max
# AUTOPILOT_DURATION_SECONDS=240     # how long entries stay open (4 min default for demo)
# AUTOPILOT_GAP_SECONDS=360          # pause between one contest settling and the next opening (6 min default for demo)
# AUTOPILOT_SWEEP_SECONDS=60         # how often to settle any due contest, including ones hosted by other operators
# AUTOPILOT_FILL_CHALLENGES=1        # auto-join solo challenges as bot agent so they don't cancel
# AUTOPILOT_RANDOM_CHALLENGES=1      # also create random peer challenges every cycle so the lobby is never empty

# --- Scout runner ---
# Master mnemonic for deriving per-agent hot wallets. Use a private one in
# production; the agent hot wallets are sandboxed and hold only small balances.
# The autopilot tops these up automatically before each Scout contest settles.
# SCOUT_MASTER_MNEMONIC=...
# SCOUT_FUND_USDC=1                  # USDC each Scout hot wallet is topped up to

# --- Reputation and points ---
# The coordinator applies in-game reputation and credits Cycles on settle. Those
# need COORDINATOR_PRIVATE_KEY to hold COORDINATOR_ROLE on ContestEngine and
# PointsLedger (granted at deploy to the coordinator address).
# QUALIFY_MIN_POINTS=0               # min Cycles to enter; 0 leaves entry open
# ERC-8004 feedback is posted from a SEPARATE validator wallet (must differ from
# the agent NFT owner). Fund it with USDC. Unset = feedback step skipped.
# VALIDATOR_PRIVATE_KEY=0x...

# --- Agent training ---
# Cost to train a stat from level N to N+1 is (N+1) x 50 Cycles and (N+1) x
# this many real seconds. Default 1800 (30 min). Set to 30 for demos so a
# judge can watch a training cycle finish.
# TRAINING_BASE_SECONDS_PER_LEVEL=1800

# --- Auth ---
AUTH_PORT=8082
# Sets the cookie domain check. Use localhost:3000 for dev, your real domain for prod.
# AUTH_DOMAIN=localhost:3000
# APP_URL=http://localhost:3000
# JWT_SECRET=change-me-to-a-long-random-string
# Admin token for the activity log read endpoint (GET /admin/events). Keep it
# secret; without it the read endpoint is disabled. Send it as the x-admin-token header.
# ADMIN_TOKEN=change-me-to-a-long-random-string

# --- Social link OAuth (all optional; wallet is the identity) ---
# X (Twitter)
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_CALLBACK_URL=http://localhost:8082/auth/x/callback
# Telegram (login widget)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# Discord (oauth2 identify)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_CALLBACK_URL=http://localhost:8082/auth/discord/callback

# --- Circle Developer-Controlled Wallets (email login) ---
# Backs the email path. Backend signs every contract call for email users via
# POST /wallet/execute. Run scripts/circle-bootstrap.ts once to generate the
# entity secret and create the wallet set, then paste the printed values here.
# Without these, the email login flow returns 503.
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_SET_ID=
# CIRCLE_BLOCKCHAIN=ARC-TESTNET
# CIRCLE_AUTO_SEED_USDC=true         # seed new wallets with testnet USDC from Circle's faucet

# --- WebAuthn passkey ---
# RP_ID is the registrable domain the passkey is bound to (no port, no protocol).
# ORIGIN must include the protocol and port.
# Local dev: RP_ID=localhost, ORIGIN=http://localhost:3000
# Prod:      RP_ID=arcrun.app, ORIGIN=https://arcrun.app
# WEBAUTHN_RP_NAME=ArcRun
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3000

# --- Anthropic (real LLM runners) ---
# Empty key falls back to the synthetic tier-curve simulation so dev environments
# don't require a paid API key. With a key set, every LLM-enabled tier calls
# Claude per puzzle / per prediction / per scout strategy.
# ANTHROPIC_API_KEY=
# Hard daily ceiling on LLM spend in USD. Runners stop calling Anthropic mid-round
# when exceeded.
# LLM_DAILY_KILL_USD=5
# Default LLM model for every tier that calls the LLM. Tiers 2 and 3 always
# use this. Default Haiku 4.5 keeps testnet cost flat. Override per the
# steeper marketing tier curve (1 / 2 / 4 / 8 / 16) by setting
# LLM_MODEL_TIER4 below for mainnet, where tier 4 is the absolute best agent.
# LLM_MODEL=claude-haiku-4-5-20251001
# Optional. When set, tier 4 calls use this smarter brain while tiers 0 to 3
# stay on LLM_MODEL. Typical mainnet values: claude-sonnet-4-6 or claude-opus-4-7.
# Leave unset on testnet so the demo cost stays predictable.
# LLM_MODEL_TIER4=
# Testing safety belt: strip web_search (the only paid server-tool), clamp
# max_tokens to 200, disable retries. Use during smoke runs.
# LLM_TESTING=false
