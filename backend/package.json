{
  "name": "agon-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agon backend: indexer, auth, and coordinator services for Arc testnet.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "tsx src/db/migrate.ts",
    "circle:bootstrap": "tsx scripts/circle-bootstrap.ts",
    "indexer": "tsx src/indexer/index.ts",
    "indexer:dev": "tsx watch src/indexer/index.ts",
    "auth": "tsx src/auth/index.ts",
    "coordinator": "tsx src/coordinator/index.ts",
    "open-contest": "tsx src/coordinator/openContest.ts",
    "fund-scouts": "tsx src/coordinator/fundScouts.ts",
    "backfill:syndicate-week": "tsx src/coordinator/backfillSyndicateWeek.ts",
    "backfill:mission-refunds": "tsx src/coordinator/backfillMissionRefunds.ts",
    "missions:clear": "tsx src/coordinator/clearMissions.ts",
    "nanopay:doctor": "tsx scripts/nanopay-doctor.ts",
    "nanopay:deposit": "tsx scripts/nanopay-deposit.ts",
    "nanopay:probe": "tsx scripts/nanopay-probe.ts",
    "swap:probe": "tsx scripts/swap-probe.ts",
    "verify:root": "tsx scripts/verify-root.ts",
    "test:prediction": "tsx scripts/prediction-examples.ts",
    "test:agon": "node --experimental-strip-types --test test/agon/*.test.ts",
    "test:nanopayments": "node --experimental-strip-types --test test/nanopayments/*.test.ts",
    "prove:agon": "node --experimental-strip-types scripts/prove-agon-foundation.ts",
    "prove:agon-writes": "tsx -r dotenv/config scripts/prove-agon-write-readiness.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@circle-fin/adapter-circle-wallets": "1.3.2",
    "@circle-fin/adapter-viem-v2": "1.11.2",
    "@circle-fin/app-kit": "1.7.0",
    "@circle-fin/developer-controlled-wallets": "9.6.0",
    "@circle-fin/provider-stablecoin-service-swap": "1.1.5",
    "@circle-fin/swap-kit": "1.2.3",
    "@circle-fin/x402-batching": "3.0.4",
    "@hono/node-server": "^1.13.7",
    "@simplewebauthn/server": "^13.0.0",
    "@x402/core": "^2.15.0",
    "@x402/evm": "^2.15.0",
    "bullmq": "^5.34.0",
    "dotenv": "^17.4.2",
    "hono": "^4.6.14",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "siwe": "^3.0.0",
    "viem": "2.50.4",
    "ws": "^8.18.0",
    "x402-fetch": "^1.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
