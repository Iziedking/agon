{
  "name": "agon",
  "version": "0.1.0",
  "private": true,
  "description": "Agon monorepo: smart contracts, backend services, and frontend. Convenience scripts that delegate to each package.",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "asp": "node --no-warnings --experimental-strip-types frontend/scripts/asp.ts",
    "stack:up": "docker compose -f backend/docker-compose.local.yml up --build -d",
    "stack:down": "docker compose -f backend/docker-compose.local.yml down",
    "stack:logs": "docker compose -f backend/docker-compose.local.yml logs -f",
    "release:check": "powershell -ExecutionPolicy Bypass -File scripts/check-agon-release.ps1",
    "package:agon-skill": "powershell -ExecutionPolicy Bypass -File scripts/package-agon-skill.ps1",
    "package:agon-build-skill": "powershell -ExecutionPolicy Bypass -File scripts/package-agon-build-skill.ps1",
    "migrate": "cd backend && npm run migrate",
    "indexer": "cd backend && npm run indexer",
    "indexer:dev": "cd backend && npm run indexer:dev",
    "auth": "cd backend && npm run auth",
    "coordinator": "cd backend && npm run coordinator",
    "build:contracts": "cd contracts && forge build",
    "test:contracts": "cd contracts && forge test"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "1.11.2",
    "@circle-fin/app-kit": "1.7.0"
  }
}
