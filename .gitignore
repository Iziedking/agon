# Operator/dev scripts: local-only by default (some may carry admin keys or
# role grants), but commit the repo-safe, secret-free ones the box and the
# ops runbook actually need. These read keys from env, never hardcode them.
scripts/
!backend/scripts/
backend/scripts/*
!backend/scripts/circle-bootstrap.ts
!backend/scripts/verify-contracts.ts
!contracts/scripts/
contracts/scripts/*
