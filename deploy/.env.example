
POSTGRES_PASSWORD=<long-random-password>

# --- Public URLs and identity ---
APP_URL=https://arcrun.xyz
AUTH_DOMAIN=arcrun.xyz
WEBAUTHN_RP_NAME=ArcRun
WEBAUTHN_RP_ID=arcrun.xyz
WEBAUTHN_ORIGIN=https://arcrun.xyz

# --- Chain ---
ARC_RPC_HTTP=https://rpc.testnet.arc.network
ARC_RPC_WS=wss://rpc.testnet.arc.network
CHAIN_ID=5042002
START_BLOCK=43667548
DEPLOYMENTS_FILE=../contracts/deployments/arc-testnet.json

# --- Signing keys (distinct wallets; never the same address) ---
COORDINATOR_PRIVATE_KEY=<fill in 0x...>
VALIDATOR_PRIVATE_KEY=<fill in 0x...>
SCOUT_MASTER_MNEMONIC=<fill in 12-word mnemonic>
JWT_SECRET=<long random string>

# --- LLM ---
ANTHROPIC_API_KEY=<fill in>

# --- Circle Developer-Controlled Wallets (email login) ---
CIRCLE_API_KEY=<fill in>
CIRCLE_ENTITY_SECRET=<fill in>
CIRCLE_WALLET_SET_ID=<fill in>
CIRCLE_BLOCKCHAIN=ARC-TESTNET
CIRCLE_AUTO_SEED_USDC=true

# --- Production gates (on for production) ---
EMAIL_OTP_ENABLED=true
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@arcrun.xyz
RESEND_API_KEY=<fill in>
OTP_PEPPER=<long random string>
STRICT_WALLET_SEPARATION=true

# --- Arcana Markets ---
ARCANA_MARKETS_ADDRESS=0x443a47eF1025e047879b1BA08c94e6dedB354D54
ARCANA_START_BLOCK=43667548

# --- Social login (optional) ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=https://api.arcrun.xyz/auth/x/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=https://api.arcrun.xyz/auth/discord/callback
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Nanopayments research (x402); see backend .env.example for the matrix ---
NANOPAY_ENABLED=1
NANOPAY_WALLET_ADDRESS=<circle agent wallet>
NANOPAY_ANALYST_NEWS_ENDPOINT=https://api.itsgloria.ai/news-by-keyword
NANOPAY_SCOUT_PRICE_ENDPOINT=https://api.aisa.one/apis/v2/coingecko/simple/price?ids=ethereum,usd-coin&vs_currencies=usd
NANOPAY_QUIZ_ENDPOINT=https://api.exa.ai/search
NANOPAY_CLASSIFY_ENDPOINT=https://api.exa.ai/search

# --- Scout real DEX swaps (Circle App Kit Swap on Arc) ---
# On: Scout makes real USDC/EURC/cirBTC swaps instead of self-transfers.
# Get a kit key from the Circle Console; it is separate from CIRCLE_API_KEY.
# Put the real key only here on the box, never in the committed example.
SCOUT_REAL_SWAPS=1
CIRCLE_KIT_KEY=<fill in kit key>

# --- LLM tuning ---
# Tier 0-3 run the cheap model; tier 4 gets the smarter one. LLM_DAILY_KILL_USD
# is a hard daily spend cap that kills the runner if exceeded. LLM_TESTING=true
# trims token use for demos; set false for full-strength runs.
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MODEL_TIER4=claude-sonnet-4-6
LLM_DAILY_KILL_USD=1
LLM_TESTING=true

# --- Admin ---
ADMIN_TOKEN=<long random string>
