
POSTGRES_PASSWORD=<long-random-password>

# --- Public URLs and identity ---
APP_URL=https://arcrun.xyz
AUTH_DOMAIN=arcrun.xyz
WEBAUTHN_RP_NAME=ArcRun
WEBAUTHN_RP_ID=arcrun.xyz
WEBAUTHN_ORIGIN=https://arcrun.xyz

# --- Chain ---
ARC_RPC_HTTP=https://rpc.testnet.arc.network
ARC_RPC_WS=wss://rpc.testnet.arc.network
CHAIN_ID=5042002
# The block the current contracts were deployed at. Keep this in step with
# `deployBlock` in contracts/deployments/arc-testnet.json, or the indexer scans
# millions of empty blocks on a cold start.
START_BLOCK=46548348
DEPLOYMENTS_FILE=../contracts/deployments/arc-testnet.json

# --- Signing keys (distinct wallets; never the same address) ---
COORDINATOR_PRIVATE_KEY=<fill in 0x...>
VALIDATOR_PRIVATE_KEY=<fill in 0x...>
SCOUT_MASTER_MNEMONIC=<fill in 12-word mnemonic>
JWT_SECRET=<long random string>
# Treasury EOA key: the wallet PrizeEscrow forwards listing fees + platform-fee
# skims to. The admin "withdraw treasury" signs with THIS key, not the
# coordinator's. Must be the address set as PrizeEscrow.treasury(). If the
# treasury and coordinator are the same wallet, leave this unset.
TREASURY_PRIVATE_KEY=<fill in 0x... treasury wallet, or leave unset>

# --- LLM ---
ANTHROPIC_API_KEY=<fill in>

# --- Circle Developer-Controlled Wallets (email login) ---
CIRCLE_API_KEY=<fill in>
CIRCLE_ENTITY_SECRET=<fill in>
CIRCLE_WALLET_SET_ID=<fill in>
CIRCLE_BLOCKCHAIN=ARC-TESTNET
CIRCLE_AUTO_SEED_USDC=true

# --- Production gates (on for production) ---
EMAIL_OTP_ENABLED=true
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@arcrun.xyz
RESEND_API_KEY=<fill in>
OTP_PEPPER=<long random string>
STRICT_WALLET_SEPARATION=true

# --- Arcana Markets ---
ARCANA_MARKETS_ADDRESS=0x443a47eF1025e047879b1BA08c94e6dedB354D54
ARCANA_START_BLOCK=43667548

# --- Social login (optional) ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=https://api.arcrun.xyz/auth/x/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=https://api.arcrun.xyz/auth/discord/callback
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Chat the in-app feedback widget relays bug/idea reports to. Message the bot
# once, then get the chat id (e.g. via @userinfobot or the bot's getUpdates).
FEEDBACK_TELEGRAM_CHAT_ID=

# --- Nanopayments research (x402); see backend .env.example for the matrix ---
# SOLVER "research" puzzles are now natural multiple-choice questions answered
# from a live Exa web search (the agent pays x402, reads results, answers A-D).
# Research uses NANOPAY_RESEARCH_ENDPOINT, falling back to NANOPAY_QUIZ_ENDPOINT
# (both Exa). Research puzzles only generate when one of these is set.
NANOPAY_RESEARCH_ENDPOINT=https://api.exa.ai/search
NANOPAY_RESEARCH_LABEL=Exa web search
NANOPAY_ENABLED=1
NANOPAY_WALLET_ADDRESS=<circle agent wallet>
NANOPAY_ANALYST_NEWS_ENDPOINT=https://api.itsgloria.ai/news-by-keyword
NANOPAY_SCOUT_PRICE_ENDPOINT=https://api.aisa.one/apis/v2/coingecko/simple/price?ids=ethereum,usd-coin&vs_currencies=usd
NANOPAY_QUIZ_ENDPOINT=https://api.exa.ai/search
NANOPAY_CLASSIFY_ENDPOINT=https://api.exa.ai/search
# Predexon (prediction-market counts) is no longer used for research puzzles;
# its 402 is non-standard and not payable by the SDK. Left here only if you
# want to point a different puzzle kind at it.
# Market intel is bought from ArcRun's OWN x402 seller (see X402_SELLER_* below),
# which settles as a Circle Gateway nanopayment on Arc Testnet. The auth service
# hosts it, so from inside the compose network this is the auth host on the
# seller's port.
NANOPAY_PREDICTION_ENDPOINT=http://auth:8090/x402/market-intel
NANOPAY_PREDICTION_LABEL=ArcRun market intel (Circle Nanopayments)

# --- ArcRun's own x402 seller (Circle Gateway nanopayments, on Arc) ------------
# Agents pay the platform sub-cent USDC for live market intel, gaslessly, over
# Circle Gateway's batched settlement rail. Selling it ourselves is what puts
# Circle's nanopayment rail on ARC, the chain the product is built on: every
# third-party x402 seller we integrated settles somewhere else.
X402_SELLER_ENABLED=1
# Address credited with the sale. Must NOT be the buyer wallet. Treasury by default.
X402_SELLER_ADDRESS=0xae410741D2b6785cd52EAE02D4f617F396a06Bb2
X402_SELLER_PORT=8090
X402_SELLER_PRICE=$0.001
# How x402 payments are made (all container-native, signed from
# NANOPAY_WALLET_PRIVATE_KEY, no Circle CLI):
#   auto  - route PER SELLER by reading each seller's 402 quote. A quote whose
#           `extra.name` is `GatewayWalletBatched` is a Circle Nanopayment and
#           goes to the Gateway batching client; every other quote goes to the
#           exact client. RECOMMENDED, because our sellers are mixed.
#   exact - standard x402 "exact" scheme via x402-fetch, for sellers that settle
#           directly on their own chain (Exa, Gloria).
#   sdk   - force every call through the @circle-fin/x402-batching GatewayClient.
#           Only correct if every seller is Gateway-batched.
#   cli   - shell out to `circle services pay` (needs the CLI in-container;
#           avoid).
NANOPAY_PROVIDER=auto
#
# Seller matrix, confirmed by live 402 probe and a real payment on 2026-07-12.
#   Exa      api.exa.ai        exact scheme, Base mainnet (eip155:8453) ~0.007 USDC/call
#   Gloria   api.itsgloria.ai  exact scheme, Base mainnet (eip155:8453) ~0.05  USDC/call
#   ArcRun   (ourselves)       GatewayWalletBatched = Circle Nanopayments,
#                              ARC TESTNET (eip155:5042002)             ~0.001 USDC/call
#
# The Gateway batching client is built on ONE chain (NANOPAY_GATEWAY_CHAIN), and a
# Gateway balance is spent on the chain it lives on. We point it at Arc Testnet,
# where our own seller quotes, so a Gateway-batched seller on any OTHER chain is
# not reachable from this config. Paying one would need a funded Gateway balance on
# that chain, which is a separate operational decision. Check the Nanopayments
# column in Circle's supported-blockchains table for the chain you have in mind.
#
# So the wallet needs TWO kinds of funding:
#   1. Plain USDC on BASE MAINNET, for the exact-scheme sellers (Exa, Gloria).
#      No Gateway deposit needed; the exact scheme spends the wallet balance.
#   2. A Circle Gateway deposit on ARC TESTNET, for our own nanopayment seller.
#      Fund it with `npx tsx scripts/gateway-deposit.ts --yes --chain arcTestnet`
#      and read balances with `npx tsx scripts/gateway-probe.ts`.
#
# Chain the Gateway batching client is built on. Must match the chain the
# Gateway-batched seller quotes. Our seller quotes Arc Testnet.
NANOPAY_GATEWAY_CHAIN=arcTestnet
# (NANOPAY_EXACT_NETWORK is no longer used; the exact client signs for whichever
# network each seller declares in its own 402 quote.)
# Private key of the Gateway-funded agent wallet (the one behind
# NANOPAY_WALLET_ADDRESS). Export it from wherever you created the agent wallet.
# Keep the real value only on the box, never in this committed example.
NANOPAY_WALLET_PRIVATE_KEY=<0x... agent wallet private key>
# (NANOPAY_GATEWAY_CHAIN is set once, above, to arcTestnet. It used to be set a
# second time here, which silently overrode it. Do not reintroduce a second
# assignment: the last one in the file wins.)
# Fallback ONLY if you stay on NANOPAY_PROVIDER=cli and the CLI isn't in the
# container: fetch research over plain HTTPS (no USDC moves). Not needed with
# the SDK provider.
NANOPAY_HTTP_FALLBACK=0
NANOPAY_API_KEYS={"api.exa.ai":"<exa key>","api.itsgloria.ai":"<gloria key>"}

# --- Scout real DEX swaps (Circle Swap Kit on Arc) ---
#
# !! IF YOU LEAVE THE PLACEHOLDER BELOW UNFILLED, SCOUT SILENTLY PRODUCES ONLY
# !! SELF-TRANSFERS. Not swaps. It has happened: an on-chain audit of the agent
# !! hot wallets found ZERO swaps. The old code treated any non-empty string as a
# !! valid key, attempted the swap, had Swap Kit reject it, and quietly fell back.
# !! The key's SHAPE is now validated and the coordinator logs "[scout-swap] REAL
# !! SWAPS ARE OFF: ..." at boot if it is wrong. Check the coordinator logs after
# !! deploying, and confirm with: npx tsx -r dotenv/config scripts/scout-swap-diagnose.ts
#
# Swaps DO fill on Arc Testnet. A probe swapped 1.0 USDC to 0.908261 EURC and back,
# and quotes fill at every Scout size (2 to 25 USDC) up to at least 50.
#
# The kit key authorizes the swap with Circle's Stablecoin Service. It is SEPARATE
# from CIRCLE_API_KEY. Get it from the Circle Console. Format: KIT_KEY:<id>:<secret>.
# Put the real value only here on the box, never in the committed example.
SCOUT_REAL_SWAPS=1
CIRCLE_KIT_KEY=KIT_KEY:<keyId>:<keySecret>
# Each agent runs a USDC -> EURC swap and the EURC -> USDC swap back, so the
# arcscan tape shows real token-to-token swaps in both directions.
# USDC is the gas token on Arc, so each swap leg must leave this much behind for
# gas. Measured cost of a real swap leg on Arc Testnet is about 0.025 USDC, so
# 0.05 is a 2x buffer. This used to be 0.10, and because the total reserve is
# `this x (roundTrips x 2 + 1)`, a busy agent reserved more than its whole balance
# and never swapped at all. The runner now shrinks the trip count to fit instead
# of abandoning the swap, but keep this tight anyway.
SCOUT_GAS_RESERVE_USDC=0.05

# --- LLM tuning ---
# Tier 0-3 run the cheap model; tier 4 gets the smarter one. LLM_DAILY_KILL_USD
# is a hard daily spend cap that kills the runner if exceeded. LLM_TESTING=true
# trims token use for demos; set false for full-strength runs.
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MODEL_TIER4=claude-sonnet-4-6
LLM_DAILY_KILL_USD=1
LLM_TESTING=true

# --- Admin ---
ADMIN_TOKEN=<long random string>
