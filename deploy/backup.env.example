# Off-box backup target: Backblaze B2. Copy this to deploy/backup.env on the VPS
# and fill in a B2 application key. backup.env is gitignored, so the key never
# enters the repo. When this file is absent, backup.sh writes local files only.
#
#   cp deploy/backup.env.example deploy/backup.env
#   chmod 600 deploy/backup.env
#   # then edit the four values below
#
# Create the key in the Backblaze console: Account > Application Keys >
# "Add a New Application Key". Scope it to the ONE bucket below and give it
# read+write. You get a keyID and an applicationKey (the key is shown once).

# The bucket you created for backups (e.g. arcrun-backups).
B2_BUCKET=

# The application key's keyID and the key value.
B2_KEY_ID=
B2_APP_KEY=

# Folder prefix inside the bucket. Default "arcrun".
B2_PREFIX=arcrun

# Optional: delete remote copies older than this many days. Leave UNSET and use
# a B2 bucket Lifecycle Rule instead (safer, provider-native). Only set this if
# you want the backup script itself to prune old off-box copies.
# B2_KEEP_DAYS=30
