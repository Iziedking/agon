# VPS-only BNB service configuration. Do not source shell .env files.
# Use a dedicated restricted database user. Keep PostgreSQL private.
BNB_DATABASE_URL=
# Exact canonical frontend origin for sign-in and state-changing requests.
BNB_APP_ORIGIN=
# Optional RPC overrides, validated against their expected chain IDs.
BNB_56_RPC_URL=
BNB_97_RPC_URL=
# 0 disables new LP analysis. No signing or payment authority is configured.
BNB_LP_AGENT_DAILY_LIMIT=
# Server-side provider configuration. Keep these values in the VPS env only.
BNB_LP_AGENT_HIRING_ENABLED=false
BNB_LP_AGENT_EXECUTION_ENABLED=false
BNB_LP_AGENT_ID=
BNB_LP_AGENT_ADDRESS=
BNB_LP_AGENT_PRICE_RAW=
BNB_LP_AGENT_PUBLIC_URL=
BNB_LP_AGENT_HIRE_DAILY_LIMIT=1
BNB_LP_AGENT_DELIVERABLE_BASE_URL=
# Worker polls for funded jobs at this interval. Keep it above 100ms and below 10m.
BNB_LP_AGENT_WORKER_INTERVAL_MS=30000
# Prefer a server-mounted session file. Never commit or paste its contents.
ALTANA_SESSION_FILE=
