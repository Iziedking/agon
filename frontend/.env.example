# Copy to .env.local for local dev. Values prefixed NEXT_PUBLIC_ are exposed to
# the browser, which is fine for these (public endpoints and a public client key).

# Product identity. Use these values for the standalone Agon deployment.
NEXT_PUBLIC_PRODUCT_VARIANT=agon
NEXT_PUBLIC_SITE_URL=https://agon.surf
NEXT_PUBLIC_AGON_API_URL=https://api.agon.surf
# Set only on disposable inspection previews. Never enable for production.
NEXT_PUBLIC_AGON_PREVIEW_FIXTURES=0

# Backend auth service
NEXT_PUBLIC_AUTH_URL=https://api.agon.surf

# Coordinator live fanout (WebSocket)
NEXT_PUBLIC_WS_URL=wss://ws.agon.surf

# WalletConnect project id (free, from https://cloud.reown.com). Powers the
# RainbowKit wallet picker's WalletConnect / mobile-QR option. Without it the
# injected and Coinbase wallet paths still work; only the QR option is disabled.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Email login is now backend-driven: the backend signs writes for the user
# through Circle Developer-Controlled wallets. The frontend reads no Circle
# config; configure CIRCLE_API_KEY / CIRCLE_ENTITY_SECRET / CIRCLE_WALLET_SET_ID
# on the backend instead. See backend/scripts/circle-bootstrap.ts.
