{
  "name": "bnb-agent-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BNB market subtree for hackathon submission.",
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "start:api": "node --experimental-strip-types src/shared/server/serve.ts",
    "test:transport": "node --experimental-strip-types src/shared/server/serve.test.ts",
    "test:boundaries": "node --experimental-strip-types src/shared/server/boundary.test.ts",
    "test:auth": "node --experimental-strip-types src/shared/server/auth.integration.test.ts",
    "test:commerce": "node --experimental-strip-types src/shared/server/commerce.test.ts",
    "test:lp-agent": "node --experimental-strip-types src/shared/providers/lp-core.test.ts",
    "test:lp-storage": "node --experimental-strip-types src/shared/providers/lp-runs.integration.test.ts --local-db",
    "prove:lp-agent": "node --experimental-strip-types scripts/prove-lp-agent.ts",
    "prove:reads": "node --experimental-strip-types scripts/prove-live-reads.ts",
    "prove:commerce": "node --experimental-strip-types scripts/prove-commerce.ts",
    "test": "node --experimental-strip-types src/lib/bnb/compare.test.ts && node --experimental-strip-types src/lib/bnb/evidence.test.ts && node --experimental-strip-types src/lib/bnb/quote-job.test.ts"
  },
  "dependencies": {
    "@bnbagent/sdk": "0.5.5",
    "geist": "1.7.2",
    "next": "15.5.25",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.50.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "overrides": { "postcss": "8.5.26", "ws": "8.21.0" }
}
