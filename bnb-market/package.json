{
  "name": "bnb-agent-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone BNB agent marketplace product.",
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "start:api": "node --experimental-strip-types src/shared/server/serve.ts",
    "test:transport": "node --experimental-strip-types src/shared/server/serve.test.ts",
    "test:boundaries": "node --experimental-strip-types src/shared/server/boundary.test.ts",
    "test:auth": "node --experimental-strip-types src/shared/server/auth.integration.test.ts",
    "test:commerce": "node --experimental-strip-types src/shared/server/commerce.test.ts && node --experimental-strip-types src/shared/server/commerce-intent-core.test.ts",
    "test:commerce-storage": "node --experimental-strip-types src/shared/server/commerce-intents.integration.test.ts --local-db",
    "test:lp-delivery": "node --experimental-strip-types src/shared/server/lp-delivery.test.ts",
    "test:lp-delivery-storage": "node --experimental-strip-types src/shared/server/lp-delivery.integration.test.ts --local-db",
    "worker:lp-delivery": "node --experimental-strip-types scripts/lp-delivery-worker.ts",
    "test:lp-agent": "node --experimental-strip-types src/shared/providers/lp-core.test.ts",
    "test:lp-storage": "node --experimental-strip-types src/shared/providers/lp-runs.integration.test.ts --local-db",
    "inspect:lp-agent": "node --experimental-strip-types scripts/inspect-lp-agent.ts",
    "inspect:live-reads": "node --experimental-strip-types scripts/inspect-live-reads.ts",
    "inspect:commerce": "node --experimental-strip-types scripts/inspect-commerce.ts",
    "inspect:marketplace": "node --experimental-strip-types scripts/inspect-marketplace.ts",
    "check:marketplace-readiness": "node --experimental-strip-types scripts/check-marketplace-readiness.ts",
    "validate:market-evidence": "node --experimental-strip-types scripts/validate-partner-evidence.ts",
    "validate:partner-evidence": "node --experimental-strip-types scripts/validate-partner-evidence.ts",
    "report:service-comparison": "node --experimental-strip-types scripts/build-service-comparison-report.ts",
    "test:unit": "npm test && npm run test:boundaries && npm run test:transport && npm run test:commerce && npm run test:lp-delivery && npm run test:lp-agent",
    "audit:product": "npm run typecheck && npm run test:unit && npm run build",
    "test": "node --experimental-strip-types src/lib/bnb/chains.test.ts && node --experimental-strip-types src/lib/bnb/compare.test.ts && node --experimental-strip-types src/lib/bnb/evidence.test.ts && node --experimental-strip-types src/lib/bnb/quote-job.test.ts && node --experimental-strip-types src/shared/marketplace/capabilities.test.ts && node --experimental-strip-types src/shared/marketplace/category-coverage.test.ts && node --experimental-strip-types src/shared/marketplace/partner-evidence.test.ts"
  },
  "dependencies": {
    "@altananetwork/sdk": "0.7.1",
    "@bnbagent/sdk": "0.5.5",
    "geist": "1.7.2",
    "next": "15.5.25",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.50.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.26",
    "ws": "8.21.0"
  }
}
