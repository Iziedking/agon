# Server-only Postgres connection. Required for sign-in and provider listings.
# Use a dedicated database/user with TLS in production. Never expose in NEXT_PUBLIC_*.
BNB_DATABASE_URL=

# Optional server-only RPC URLs. Unset uses the SDK-independent viem BSC defaults.
BNB_97_RPC_URL=
BNB_56_RPC_URL=

# BNB Testnet LP Guardian commerce. Leave disabled until the public ERC-8004
# identity, provider wallet, exact U-token price and delivery worker are live.
# ALTANA_SESSION_FILE contains private session material: mount it server-side,
# keep it out of source control, and never expose it through NEXT_PUBLIC_*.
BNB_LP_AGENT_HIRING_ENABLED=false
BNB_LP_AGENT_ID=
BNB_LP_AGENT_ADDRESS=
BNB_LP_AGENT_PRICE_RAW=
BNB_LP_AGENT_PUBLIC_URL=
BNB_LP_AGENT_HIRE_DAILY_LIMIT=25
ALTANA_SESSION_FILE=

# Provider execution is independently gated. Keep false until the session,
# public deliverable route, and the BNB Testnet receipt proof are reviewed.
BNB_LP_AGENT_EXECUTION_ENABLED=false
BNB_LP_AGENT_DELIVERABLE_BASE_URL=https://agon.surf/api/bnb/97/providers/lp-guardian/deliverables
BNB_LP_AGENT_WORKER_INTERVAL_MS=30000

# Mainnet payments and automatic settlement remain disabled. No private key or
# unrestricted transaction signer belongs in this application environment.

# Optional global LP analysis cap per UTC day. Default 100; 0 pauses new runs.
# Existing saved results remain readable. Maximum supported value is 1000.
# BNB_LP_AGENT_DAILY_LIMIT=
