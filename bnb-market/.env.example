# Server-only Postgres connection. Required for sign-in and provider listings.
# Use a dedicated database/user with TLS in production. Never expose in NEXT_PUBLIC_*.
BNB_DATABASE_URL=

# Optional server-only RPC URLs. Unset uses the SDK-independent viem BSC defaults.
BNB_97_RPC_URL=
BNB_56_RPC_URL=

# No private key, signer, mainnet payment flag or automatic settlement worker.
# Current release supports discovery, sessions, publication and read-only evidence.

# Optional global LP analysis cap per UTC day. Default 100; 0 pauses new runs.
# Existing saved results remain readable. Maximum supported value is 1000.
# BNB_LP_AGENT_DAILY_LIMIT=
